# ─── Database ───────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (read-write, for migrations/seeding only)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Read-only user for query execution (create this user in Supabase SQL editor)
DATABASE_READONLY_URL=postgresql://readonly_user:READONLY_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
MAX_SUBQUERY_DEPTH=3
ENABLE_MULTI_QUERY_VALIDATION=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
